{
  "uid": "midterm-overview",
  "title": "DistributedMidterm \u2014 Storage Health & Repair",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Online storage nodes",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "midterm-prom"
      },
      "targets": [
        {
          "expr": "sum(storage_node_healthy)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total physical chunks",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "midterm-prom"
      },
      "targets": [
        {
          "expr": "sum(storage_node_chunks)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Object versions",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "midterm-prom"
      },
      "targets": [
        {
          "expr": "storage_object_versions",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Degraded in latest scrub batch",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "midterm-prom"
      },
      "targets": [
        {
          "expr": "storage_degraded_in_latest_batch",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Chunks per node",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "midterm-prom"
      },
      "targets": [
        {
          "expr": "storage_node_chunks",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Free space per node",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "midterm-prom"
      },
      "targets": [
        {
          "expr": "storage_node_free_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Repaired shards in latest pass",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "midterm-prom"
      },
      "targets": [
        {
          "expr": "storage_repair_shards_latest",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Repair transfer bytes (latest pass)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "midterm-prom"
      },
      "targets": [
        {
          "expr": "storage_repair_bytes_latest",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Metric collection success",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "midterm-prom"
      },
      "targets": [
        {
          "expr": "storage_metrics_scrape_success",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Load balancer requests per second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "midterm-prom"
      },
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total[1m])",
          "refId": "A"
        }
      ]
    }
  ]
}